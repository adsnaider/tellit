{
  "name": "difit",
  "version": "5.0.12",
  "description": "Local web diff viewer and commenting tool for Jujutsu and Git",
  "keywords": [
    "cli",
    "code-review",
    "diff",
    "diff-viewer",
    "git",
    "jujutsu",
    "review",
    "svelte",
    "tailwind"
  ],
  "license": "MIT",
  "bin": {
    "difit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cli/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:cli": "tsc --project tsconfig.cli.json && NODE_ENV=development node dist/cli/index.js",
    "build": "npm run build:cli && vite build",
    "build:cli": "tsc --project tsconfig.cli.json",
    "start": "npm run build && node dist/cli/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && oxlint . --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:fix": "oxlint . --type-aware --type-check --deny-warnings --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip --use-tsconfig-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "node scripts/measure-performance.js",
    "perf:small": "node scripts/measure-performance.js --size small",
    "perf:medium": "node scripts/measure-performance.js --size medium",
    "perf:large": "node scripts/measure-performance.js --size large",
    "perf:xlarge": "node scripts/measure-performance.js --size xlarge",
    "perf:compare": "node scripts/compare-performance.js"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "express": "^5.1.0",
    "js-yaml": "^4.3.0",
    "open": "^11.0.0",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0",
    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.8",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.0.0",
    "knip": "^6.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.54.1",
    "postcss": "^8.5.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.0",
    "undici": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.6"
  },
  "engines": {
    "node": ">=21.0.0"
  }
}
